{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's public profile information.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "avatarUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's profile picture."
        },
        "initials": {
            "type": "string",
            "description": "The user's initials."
        }
      },
      "required": ["name"]
    },
    "Team": {
      "title": "Team",
      "description": "A collection of users working together.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the team."
        },
        "description": {
          "type": "string",
          "description": "A short description of the team's purpose."
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/entities/UserProfile"
          },
          "description": "A list of users who are members of this team."
        }
      },
      "required": ["name"]
    },
    "Project": {
      "title": "Project",
      "description": "A project containing tasks.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the project."
        },
        "description": {
          "type": "string",
          "description": "A short description of the project."
        }
      },
      "required": ["name"]
    }
  },
  "auth": {
    "providers": []
  },
  "firestore": {
    "/teams/{teamId}": {
      "schema": {
        "$ref": "#/entities/Team"
      },
      "description": "Stores information about individual teams."
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores public profiles for users."
    },
    "/projects/{projectId}": {
      "schema": {
        "$ref": "#/entities/Project"
      },
      "description": "Stores information about individual projects."
    }
  }
}
